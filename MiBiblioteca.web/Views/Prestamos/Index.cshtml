@model List<MiBiblioteca.Web.Models.PrestamoViewModel>


    <h1>Préstamos</h1>


    <a asp-action="Create"
       class="btn btn-primary mb-3">
        Nuevo préstamo
    </a>


    <table class="table table-bordered">


        <thead class="table-dark">

            <tr>

                <th>Usuario</th>
                <th>Libro</th>
                <th>Fecha préstamo</th>
                <th>Fecha devolución</th>
                <th>Estado</th>
                <th>Acciones</th>

            </tr>

        </thead>


        <tbody>


            @foreach(var prestamo in Model)
            {

            <tr>

                <td>@prestamo.UsuarioId</td>

                <td>@prestamo.LibroId</td>

                <td>
                    @prestamo.FechaPrestamo.ToString("dd/MM/yyyy")
                </td>

                <td>
                    @(prestamo.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "-")
                </td>


                <td>

                    @if(prestamo.Estado == 1)
                    {
                    <span class="badge bg-success">
                        Activo
                    </span>
                    }
                    else
                    {
                    <span class="badge bg-secondary">
                        Devuelto
                    </span>
                    }

                </td>


                <td>

                    <a asp-action="Edit"
                       asp-route-id="@prestamo.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                </td>


            </tr>

            }


        </tbody>

    </table>
