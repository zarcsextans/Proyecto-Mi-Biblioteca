@model MiBiblioteca.Web.Models.PrestamoViewModel


<h1>Nuevo Préstamo</h1>


<form asp-action="Create" method="post">


    <div class="mb-3">

        <label>
            Usuario ID
        </label>

        <input asp-for="UsuarioId"
               class="form-control" />

    </div>



    <div class="mb-3">

        <label>
            Libro ID
        </label>

        <input asp-for="LibroId"
               class="form-control" />

    </div>



    <button class="btn btn-success">
        Guardar
    </button>


    <a asp-action="Index"
           class="btn btn-secondary">
        Cancelar
    </a>


</form>