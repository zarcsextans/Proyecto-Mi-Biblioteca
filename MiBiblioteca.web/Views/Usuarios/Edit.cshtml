@model MiBiblioteca.Web.Models.UsuarioViewModel


@{
    ViewData["Title"] = "Editar Usuario";
}


<h1>Editar Usuario</h1>


<form asp-action="Edit" method="post">


    <input type="hidden" asp-for="Id" />


    <div class="mb-3">

        <label class="form-label">
            Nombre
        </label>

        <input asp-for="Nombre"
               class="form-control" />

    </div>



    <div class="mb-3">

        <label class="form-label">
            Correo
        </label>

        <input asp-for="Correo"
               class="form-control" />

    </div>



    <div class="mb-3">

        <label class="form-label">
            Teléfono
        </label>

        <input asp-for="Telefono"
               class="form-control" />

    </div>



    <button type="submit"
            class="btn btn-success">
        Guardar cambios
    </button>


    <a asp-action="Index"
           class="btn btn-secondary">
        Cancelar
    </a>


</form>