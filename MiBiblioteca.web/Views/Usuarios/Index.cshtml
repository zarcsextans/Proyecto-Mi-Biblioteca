@model List<MiBiblioteca.Web.Models.UsuarioViewModel>


<h1>Usuarios</h1>


<table class="table">

    <thead>
        <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Teléfono</th>
        </tr>
    </thead>


    <tbody>

        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Nombre</td>
                <td>@usuario.Correo</td>
                <td>@usuario.Telefono</td>
            </tr>
        }

    </tbody>

</table>