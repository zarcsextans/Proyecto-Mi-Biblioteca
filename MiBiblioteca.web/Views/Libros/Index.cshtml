@model List<MiBiblioteca.Web.Models.LibroViewModel>


<h1>Libros</h1>


<table class="table">

    <thead>
        <tr>
            <th>Título</th>
            <th>Autor</th>
            <th>ISBN</th>
            <th>Año</th>
            <th>Disponible</th>
        </tr>
    </thead>


    <tbody>

        @foreach (var libro in Model)
        {
            <tr>

                <td>
                    @libro.Titulo
                </td>

                <td>
                    @libro.Autor
                </td>

                <td>
                    @libro.ISBN
                </td>

                <td>
                    @libro.AnioPublicacion
                </td>

                <td>
                    @if (libro.Disponible)
                    {
                        <span>Disponible</span>
                    }
                    else
                    {
                        <span>Prestado</span>
                    }
                </td>

            </tr>
        }

    </tbody>

</table>