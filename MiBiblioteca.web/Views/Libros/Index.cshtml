@model List<MiBiblioteca.Web.Models.LibroViewModel>


<h1>Libros</h1>


<a asp-action="Create"
       class="btn btn-primary mb-3">
    Nuevo Libro
</a>


<table class="table table-bordered">

    <thead class="table-dark">

        <tr>
            <th>Título</th>
            <th>Autor</th>
            <th>ISBN</th>
            <th>Año</th>
            <th>Disponible</th>
            <th>Acciones</th>
        </tr>

    </thead>


    <tbody>

        @foreach (var libro in Model)
        {

            <tr>

                <td>@libro.Titulo</td>

                <td>@libro.Autor</td>

                <td>@libro.ISBN</td>

                <td>@libro.AnioPublicacion</td>

                <td>
                    @if (libro.Disponible)
                    {
                        <span>Disponible</span>
                    }
                    else
                    {
                        <span>No disponible</span>
                    }
                </td>


                <td>

                    <a asp-action="Edit"
                           asp-route-id="@libro.Id"
                           class="btn btn-warning btn-sm">
                        Editar
                    </a>


                    <form asp-action="Delete"
                          asp-route-id="@libro.Id"
                          method="post"
                          style="display:inline">

                        <button class="btn btn-danger btn-sm"
                                onclick="return confirm('¿Eliminar libro?');">
                            Eliminar
                        </button>

                    </form>


                </td>


            </tr>

        }

    </tbody>

</table>